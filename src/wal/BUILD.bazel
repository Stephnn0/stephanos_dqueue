load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

cc_library(
    name = "wal",
    srcs = ["wal.cpp"],
    hdrs = ["wal.hpp"],
    copts = ["-std=c++20", "-Wall", "-Wextra"],
    visibility = ["//src:__subpackages__"],
    deps = [
        "//src/protocol",
        "//src/queue_manager",
    ],
)

cc_test(
    name = "wal_test",
    srcs = ["wal_test.cpp"],
    copts = ["-std=c++20", "-Wall", "-Wextra"],
    deps = [":wal"],
)
